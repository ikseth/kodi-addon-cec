msgctxt "#30000"
msgid "Actions"
msgstr "Actions"

msgctxt "#30010"
msgid "Allowed actions"
msgstr "Allowed actions"

msgctxt "#30011"
msgid "Allow turning the TV off (standby)"
msgstr "Allow turning the TV off (standby)"

msgctxt "#30012"
msgid "If disabled, a standby request is rejected and logged."
msgstr "If disabled, a standby request is rejected and logged."

msgctxt "#30013"
msgid "Allow turning the TV on (activate source)"
msgstr "Allow turning the TV on (activate source)"

msgctxt "#30014"
msgid "Turns the TV on and switches it to this device's HDMI input."
msgstr "Turns the TV on and switches it to this device's HDMI input."

msgctxt "#30015"
msgid "Allow toggling the TV"
msgstr "Allow toggling the TV"

msgctxt "#30016"
msgid "Disabled by default: the result depends on a state that the caller cannot see."
msgstr "Disabled by default: the result depends on a state that the caller cannot see."

msgctxt "#30020"
msgid "Feedback"
msgstr "Feedback"

msgctxt "#30021"
msgid "Show an on-screen notification when a command runs"
msgstr "Show an on-screen notification when a command runs"

msgctxt "#30022"
msgid "Errors are always shown, regardless of this setting."
msgstr "Errors are always shown, regardless of this setting."

msgctxt "#30100"
msgid "Power state"
msgstr "Power state"

msgctxt "#30110"
msgid "TV power state"
msgstr "TV power state"

msgctxt "#30111"
msgid "Publish the TV power state"
msgstr "Publish the TV power state"

msgctxt "#30112"
msgid "Periodically asks the TV over CEC whether it is on and publishes the answer as Window(Home) properties, readable over JSON-RPC."
msgstr "Periodically asks the TV over CEC whether it is on and publishes the answer as Window(Home) properties, readable over JSON-RPC."

msgctxt "#30113"
msgid "Polling interval (seconds)"
msgstr "Polling interval (seconds)"

msgctxt "#30114"
msgid "After each command the state is also re-read a few times in quick succession."
msgstr "After each command the state is also re-read a few times in quick succession."

msgctxt "#30115"
msgid "CEC adapter"
msgstr "CEC adapter"

msgctxt "#30116"
msgid "Automatic picks the first adapter with a device connected."
msgstr "Automatic picks the first adapter with a device connected."

msgctxt "#30117"
msgid "Automatic"
msgstr "Automatic"

msgctxt "#30118"
msgid "/dev/cec0"
msgstr "/dev/cec0"

